# Configuración del servidor de pruebas. iniciar.sh crea pruebas/.env con
# contraseñas y llave aleatorias si no existe.

# Llave compartida por ambos sistemas (32 caracteres). En pruebas NO use la
# llave de producción.
APP_KEY=

DB_ROOT_PASSWORD=
DB_USERNAME=sirvolab
DB_PASSWORD=

# Direcciones con las que se abren los sistemas (se usan en los enlaces de
# los correos). Con túnel SSH quedan así; cámbielas si usa un dominio.
URL_VIEJO=http://localhost:8080
URL_NUEVO=http://localhost:8081
