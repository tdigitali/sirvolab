APP_NAME=SIRVOLAB
APP_ENV=production
# IMPORTANTE: para que sigan funcionando los enlaces ya enviados por correo
# (voto, registro, edición) y los datos cifrados en la base, copie aquí la
# llave 'key' del antiguo app/config/app.php tal cual (32 caracteres, sin
# prefijo base64:). Solo genere una nueva (php artisan key:generate) en
# entornos de desarrollo.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=America/Mexico_City
APP_FORCE_HTTPS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Base de datos existente de SIRVOLAB (antes en app/config/database.php)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sirvolab
DB_USERNAME=
DB_PASSWORD=
# Mismo juego de caracteres que usaba Laravel 4
DB_CHARSET=utf8
DB_COLLATION=utf8_unicode_ci
# Laravel 4 no usaba el modo estricto de MySQL
DB_STRICT=false

# Sesiones y caché en archivos: no requieren tablas nuevas en la base.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Correo (antes en app/config/mail.php, SendGrid)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="sirvolab@stps.gob.mx"
MAIL_FROM_NAME="Notificaciones SIRVOLAB"

# Servicio de consulta de CURP (RENAPO). Antes el token estaba en el código.
RENAPO_URL=https://jovenesconstruyendoelfuturo.stps.gob.mx/bc/_testCurpRen2_bk.php
RENAPO_TOKEN=
# Segundos máximos por consulta (0 = sin límite, como en la versión anterior)
RENAPO_TIMEOUT=0
